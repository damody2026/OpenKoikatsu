+ TArrayView<FTransform> View(Initial);Data.ScaleCodec->GetPoseScales(View,Pairs,Context);for(const auto& Atom:Initial)Cache->Values.Add(Atom.GetScale3D());
+ {FWriteScopeLock Lock(GConstantScaleCacheLock);for(auto It=GConstantScaleCaches.CreateIterator();It;++It)if(!It.Value()->Owner.IsValid())It.RemoveCurrent();GConstantScaleCaches.Add(Compressed.CompressedDataStructure.Get(),Cache);GHasConstantScaleCaches.Store(true);}
