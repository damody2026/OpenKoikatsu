+ const int32 Count=Compressed.CompressedTrackToSkeletonMapTable.Num();
+ if(Data.KeyEncodingFormat!=AKF_ConstantKeyLerp||!Data.CompressedScaleOffsets.IsValid()||Data.CompressedScaleOffsets.GetNumTracks()!=Count)return false;
+ auto Cache=MakeShared<FConstantScaleCache,ESPMode::ThreadSafe>();Cache->Owner=Clip;Cache->Bytes=Data.CompressedByteStream.GetData();Cache->ByteCount=Data.CompressedByteStream.Num();Cache->Offsets=Data.CompressedScaleOffsets.OffsetData.GetData();Cache->TrackCount=Count;
+ const auto* ISPCVariable=IConsoleManager::Get().FindConsoleVariable(TEXT("a.ConstantKeyLerp.ISPC"));Cache->ISPCMode=ISPCVariable?ISPCVariable->GetInt():-1;
