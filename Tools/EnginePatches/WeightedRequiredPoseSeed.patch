+// Explicit game-component opt-in. No class layout or shared mesh data changes.
+namespace {
+struct FWeightedPoseSeed { TWeakObjectPtr<USkeletalMesh> Mesh; TArray<FBoneIndexType> Bones; };
+FCriticalSection GWeightedPoseSeedLock;
+TMap<TWeakObjectPtr<USkeletalMeshComponent>,FWeightedPoseSeed> GWeightedPoseSeeds;
+TAtomic<bool> GHasWeightedPoseSeeds{false};
+}
+ENGINE_API bool SetSkeletalWeightedPoseSeed(USkeletalMeshComponent* Component,const TArray<FBoneIndexType>* Bones)
+{
+ if(!Component)return false;
+ auto* Mesh=Component->GetSkeletalMeshAsset();
+ if(Bones){
+  if(!Mesh||Mesh->GetLODNum()!=1||Component->LeaderPoseComponent.IsValid()||Component->GetAnimationMode()!=EAnimationMode::AnimationSingleNode||Bones->IsEmpty())return false;
+  const auto& Ref=Mesh->GetRefSkeleton();TSet<int32> Present;int32 Previous=-1;
+  for(FBoneIndexType Bone:*Bones){if(Bone<=Previous||Bone>=Ref.GetNum())return false;const int32 Parent=Ref.GetParentIndex(Bone);if(Parent>=0&&!Present.Contains(Parent))return false;Present.Add(Bone);Previous=Bone;}
+ }
+ {FScopeLock Lock(&GWeightedPoseSeedLock);for(auto It=GWeightedPoseSeeds.CreateIterator();It;++It)if(!It.Key().IsValid())It.RemoveCurrent();
+  if(Bones){auto& Entry=GWeightedPoseSeeds.FindOrAdd(Component);Entry.Mesh=Mesh;Entry.Bones=*Bones;}else GWeightedPoseSeeds.Remove(Component);GHasWeightedPoseSeeds.Store(!GWeightedPoseSeeds.IsEmpty());
+ }
+ Component->RecalcRequiredBones(Component->GetPredictedLODLevel());return true;
+}
