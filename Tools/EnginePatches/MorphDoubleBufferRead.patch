 .../Runtime/Engine/Private/SkeletalRenderGPUSkin.cpp       | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/Engine/Source/Runtime/Engine/Private/SkeletalRenderGPUSkin.cpp b/Engine/Source/Runtime/Engine/Private/SkeletalRenderGPUSkin.cpp
index 1f5c4f472..ad5e0904b 100644
--- a/Engine/Source/Runtime/Engine/Private/SkeletalRenderGPUSkin.cpp
+++ b/Engine/Source/Runtime/Engine/Private/SkeletalRenderGPUSkin.cpp
@@ -339,9 +339,10 @@ uint32 FMorphVertexBufferPool::GetReadingIndex(bool bPrevious) const
 
 		if (!MorphVertexBuffers[Index].bHasBeenUpdated)
 		{
-			// this should only happen the first time updating, in which case the previous buffer hasn't been written into yet.
-			check(Index == 1);
-			Index = 0;
+			// Normally only the first update, when the previous buffer hasn't been written yet. A revision
+			// flip without a morph write (weights republished on a leader change while the mesh is still
+			// being created) can also leave the current buffer unwritten: read whichever buffer has data.
+			Index = MorphVertexBuffers[Index ^ 1].bHasBeenUpdated ? (Index ^ 1) : 0;
 		}
 	}
 	return Index;
