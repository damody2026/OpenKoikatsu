@echo off
setlocal EnableExtensions
rem Invoked by OpenKoikatsuEditor PreBuildSteps (VS: OpenKoikatsu / Development_Editor x64).
echo [ok-extract] cargo build --release --lib

set "CARGO="
where cargo >nul 2>&1
if not errorlevel 1 set "CARGO=cargo"
if not defined CARGO if exist "%USERPROFILE%\.cargo\bin\cargo.exe" set "CARGO=%USERPROFILE%\.cargo\bin\cargo.exe"
if not defined CARGO (
	echo [ok-extract] cargo.exe not found. Install Rust or add %%USERPROFILE%%\.cargo\bin to PATH.
	exit /b 1
)

rem MSBuild sets LIB to the VC tools directory and omits the Windows SDK, so
rem link.exe cannot open kernel32.lib. Append the newest installed SDK.
set "SDKROOT=C:\Program Files (x86)\Windows Kits\10\Lib"
set "SDKVER="
for /f "delims=" %%D in ('dir /b /ad /o-n "%SDKROOT%" 2^>nul') do (
	if not defined SDKVER if exist "%SDKROOT%\%%D\um\x64\kernel32.lib" set "SDKVER=%%D"
)
if defined SDKVER (
	echo [ok-extract] Windows SDK %SDKVER%
	set "LIB=%LIB%;%SDKROOT%\%SDKVER%\um\x64;%SDKROOT%\%SDKVER%\ucrt\x64"
) else (
	echo [ok-extract] Windows SDK um\x64\kernel32.lib not found
)

echo [ok-extract] using %CARGO%
rem --lib: the editor links ok_extract.lib. --cap-lints allow: rustc warnings
rem on stderr are reported by MSBuild as EXEC : warning.
rem Cargo discovers .cargo/config.toml from the working directory, not --manifest-path.
pushd "%~dp0"
if errorlevel 1 exit /b 1
set "CARGO_TERM_COLOR=never"
rem RUSTFLAGS overrides target rustflags, so preserve the required Windows flags here.
rem No +crt-static: Unreal links ok_extract.lib with the dynamic CRT (/MD); crt-static made cc build clothes_gpu.cpp as /MT
rem and the game link failed with LNK2038 (RuntimeLibrary MT_StaticRelease vs MD_DynamicRelease).
set "RUSTFLAGS=%RUSTFLAGS% -C linker-flavor=lld-link --cap-lints allow"
"%CARGO%" build --release --lib --quiet --manifest-path "%~dp0Cargo.toml"
if errorlevel 1 (
	popd
	echo [ok-extract] cargo build --release --lib failed
	exit /b 1
)
popd

set "OK_LIB=%~dp0target\release\ok_extract.lib"
if not exist "%OK_LIB%" (
	echo [ok-extract] missing %OK_LIB%
	exit /b 1
)
for %%I in ("%OK_LIB%") do set "LIBTIME=%%~tI"
echo [ok-extract] ok_extract.lib %LIBTIME%

set "STAMP=%~dp0..\..\Plugins\KKUnityBundle\Source\KKUnityBundle\Private\OKExtractBuildStamp.h"
findstr /C:"%LIBTIME%" "%STAMP%" >nul 2>&1
if errorlevel 1 (
	echo [ok-extract] stamp %LIBTIME%
	> "%STAMP%" echo #pragma once
	>> "%STAMP%" echo // Generated by Tools/ok-extract/build-release.cmd. Do not edit.
	>> "%STAMP%" echo #define OK_EXTRACT_LIB_STAMP "%LIBTIME%"
)
exit /b 0
