  },
  {
    "definition": {
      "name": "reference_prepare",
      "description": "Import three body reference masks and freeze alignment/projection. mode mask=white foreground/black background; alpha=transparent background; background=explicit RGB border-connected background removal. Pose must match. physical_height constrains stature; without it only proportions are identifiable.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string"
          },
          "front": {
            "type": "string"
          },
          "side": {
            "type": "string"
          },
          "back": {
            "type": "string"
          },
          "projection_frame": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 64,
                "maximum": 1024
              },
              "height": {
                "type": "integer",
                "minimum": 64,
                "maximum": 1024
              },
              "scale": {
                "type": "number",
                "minimum": 0.0001,
                "maximum": 1000
              },
              "center": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "floor": {
                "type": "number"
              },
              "physical_height": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10000
              },
              "projection": {
                "type": "string",
                "enum": [
                  "orthographic"
                ]
              },
              "side": {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              },
              "padding": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              }
            },
            "required": [
              "width",
              "height",
              "scale",
              "center",
              "floor",
              "physical_height",
              "projection"
            ],
            "additionalProperties": false
          },
          "side_view": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "mask",
              "alpha",
              "background"
            ]
          },
          "background": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3
          },
          "tolerance": {
            "type": "number",
            "minimum": 0,
            "maximum": 255
          },
          "physical_height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "minimum": 0.1,
            "maximum": 10000
          },
          "width": {
            "type": "integer",
            "minimum": 64,
            "maximum": 1024
          },
          "height": {
            "type": "integer",
            "minimum": 64,
            "maximum": 1024
          }
        },
        "required": [
          "session",
          "front",
          "side",
          "back"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    "action": "fit_reference"
  },
  {
    "definition": {
      "name": "body_compare",
      "description": "Compare current posed body silhouettes to prepared references: IoU and mean silhouette boundary error. Returns three current masks at the fixed reference projection.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        },
