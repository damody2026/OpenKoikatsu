          "session",
          "reference"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    "action": "fit_compare"
  },
  {
    "definition": {
      "name": "body_sensitivity",
      "description": "Probe each selected parameter in both directions against fixed reference silhouettes, return loss derivatives and changed-pixel fractions, then restore original values. Uses current model and parameter bounds, not a hardcoded influence table.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "reference": {
            "type": "string"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 128
          },
          "step_fraction": {
            "type": "number",
            "minimum": 0.0001,
            "maximum": 0.5
          }
        },
        "required": [
          "session",
          "revision",
          "reference",
          "keys"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    "action": "fit_sensitivity"
  },
  {
    "definition": {
      "name": "body_fit",
      "description": "Bounded adaptive coordinate search over any supported immediate numeric body/face/bone parameters. Defaults to all 44 body sliders. Retains best values, reports actual error and stop reason, saves resumable checkpoints. Requires matching T-pose and unclothed body; does not guarantee a unique reconstruction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
