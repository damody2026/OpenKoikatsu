  {
    "definition": {
      "name": "body_masks",
      "description": "Return body-only orthographic front/side/back silhouette PNGs from actual posed geometry. Use reference ID to retain a fixed projection across edits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string"
          },
          "side": {
            "type": "string",
