      "accept": [
        {
          "speaker": "male",
          "text_jp": "「俺……君のことが好きなんだ」",
          "text_zh": "「我……喜歡你。」",
          "voices": [],
          "row": 222
        },
        {
          "speaker": "female",
          "text_jp": "「あ……その目、本気の言葉なのね？」",
          "text_zh": "「啊……那個眼神，是認真的話語呢？」",
          "voices": [
            "ja_ogg/c00/adv/sun_ev_00_000.ogg"
          ],
          "face": "驚き",
          "source": "adv/scenario/c00/00.unity3d",
          "row": 7
        },
        {
          "speaker": "male",
          "text_jp": "「うん、冗談でこんなこと言ったりしない。本当に[H名]のことが好きなんだ」",
          "text_zh": "「嗯，我不會拿這種事開玩笑。我是真的喜歡[H名]。」",
          "voices": [],
          "face": "",
          "source": "adv/scenario/c00/00.unity3d",
          "row": 8
        },
        {
          "speaker": "female",
          "text_jp": "「……好きな人から気持ちを伝えてもらえるのって、こんなに嬉しいことだったのね」",
          "text_zh": "「……能從喜歡的人口中聽到心意，原來是這麼令人開心的事啊。」",
          "voices": [
            "ja_ogg/c00/adv/sun_ev_00_001.ogg"
          ],
          "face": "ドキドキ",
          "source": "adv/scenario/c00/00.unity3d",
          "row": 12
        },
        {
          "speaker": "male",
          "text_jp": "「え？　それって……」",
          "text_zh": "「咦？ 那是說……」",
          "voices": [],
          "face": "",
          "source": "adv/scenario/c00/00.unity3d",
          "row": 13
        },
        {
          "speaker": "female",
          "text_jp": "「ええ、私も君のことが好きよ。これからは彼氏彼女として仲良くしましょ」",
          "text_zh": "「嗯，我也喜歡你。從今以後就當男女朋友，好好相處吧。」",
          "voices": [
            "ja_ogg/c00/adv/sun_ev_00_002.ogg"
          ],
          "face": "笑顔（目閉じ）",
          "source": "adv/scenario/c00/00.unity3d",
          "row": 16
        }
      ],
      "refuse": [
        {
          "speaker": "male",
          "text_jp": "「俺……君のことが好きなんだ」",
          "text_zh": "「我……喜歡你。」",
          "voices": [],
          "row": 222
        },
        {
          "speaker": "female",
          "text_jp": "「その……気持ちは嬉しいんだけど……考える時間をもらえるかしら？　……ごめんなさい」",
          "text_zh": "「那個……心意我很高興……可以給我一點時間想嗎？　……對不起」",
          "voices": [
            "ja_ogg/c00/adv/sun_com_00_039.ogg"
          ],
          "face": "思わず目を逸らす",
          "row": 224
        }
