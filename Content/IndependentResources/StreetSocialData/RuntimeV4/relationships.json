      "accept": [
        {
          "speaker": "male",
          "text_jp": "「きみのことが好きだ」",
          "text_zh": "「我喜歡你」",
          "voices": [],
          "row": 222
        },
        {
          "speaker": "female",
          "text_jp": "「へ？　それって……私のことが、ですか？」",
          "text_zh": "「蛤？那是……說我嗎？」",
          "voices": [
            "ja_ogg/c18/adv/sun_ev_18_000.ogg"
          ],
          "face": "驚き",
          "source": "adv/scenario/c18/00.unity3d",
          "row": 7
        },
        {
          "speaker": "male",
          "text_jp": "「……うん、そうだよ。俺と付き合って欲しい」",
          "text_zh": "「……嗯，是的。請跟我交往。」",
          "voices": [],
          "face": "",
          "source": "adv/scenario/c18/00.unity3d",
          "row": 8
        },
        {
          "speaker": "female",
          "text_jp": "「び、びっくりしました……ど、どうしましょう」",
          "text_zh": "「嚇、嚇到了……該、該怎麼辦。」",
          "voices": [
            "ja_ogg/c18/adv/sun_ev_18_001.ogg"
          ],
          "face": "驚き",
          "source": "adv/scenario/c18/00.unity3d",
          "row": 10
        },
        {
          "speaker": "male",
          "text_jp": "「ごめん、驚かせるつもりはなかったんだけど」",
          "text_zh": "「抱歉，沒想嚇你的。」",
          "voices": [],
          "face": "",
          "source": "adv/scenario/c18/00.unity3d",
          "row": 11
        },
        {
          "speaker": "female",
          "text_jp": "「あ、謝らないで下さいっ！　……幸せ過ぎて、驚いただけですから」",
          "text_zh": "「請、請不要道歉！……只是幸福過頭，嚇到而已。」",
          "voices": [
            "ja_ogg/c18/adv/sun_ev_18_002.ogg"
          ],
          "face": "ドキドキ",
          "source": "adv/scenario/c18/00.unity3d",
          "row": 15
        },
        {
          "speaker": "female",
          "text_jp": "「私で良ければ、よろしくお願いしますっ」",
          "text_zh": "「如果我可以的話，請多指教。」",
          "voices": [
            "ja_ogg/c18/adv/sun_ev_18_003.ogg"
          ],
          "face": "ドキドキ",
          "source": "adv/scenario/c18/00.unity3d",
          "row": 17
        }
      ],
      "refuse": [
        {
