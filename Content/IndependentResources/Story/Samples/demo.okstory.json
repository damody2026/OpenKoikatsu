          {"text": {"zh": "今天先回家", "ja": "今日はまっすぐ帰る"}, "goto": "home", "set": {"route": 2}}
        ]}
     ]},
    {"id": "movie", "title": {"zh": "第二幕　電影院前", "ja": "第二幕　映画館の前"},
     "scene": "UserData/Studio/scene/koikatu_cs0001901.okscene",
