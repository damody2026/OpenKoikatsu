int32 RepairHairOutlines(int32 Start,int32 End,const FString& Params){
 FString Output;if(!FParse::Value(*Params,TEXT("Output="),Output)||IFileManager::Get().FileExists(*Output))return 1;TArray<TSharedPtr<FJsonValue>> Rows;
 for(int32 Index=Start;Index<End;++Index){const FString Base=FString::Printf(TEXT("/Game/Scenes/CrowdRoom/Characters/C%03d"),Index),NearRoot=Base/TEXT("NearDetailR6"),LowRoot=Base/TEXT("GameLowHairSafeR9");
  {TStrongObjectPtr<UOKCrowdFaceDetail> Previous(LoadObject<UOKCrowdFaceDetail>(nullptr,*(Base/TEXT("NearDetailR5/Face.Face"))));TStrongObjectPtr<UKKImportedCharacter> Low(LoadObject<UKKImportedCharacter>(nullptr,*(Base/TEXT("GameLowSurfaceSafeR8/Character.Character"))));TStrongObjectPtr<UKKImportedAnimationLibrary> Walk(LoadObject<UKKImportedAnimationLibrary>(nullptr,*(Base/TEXT("GameLowSurfaceSafeR8/Walk/Animations.Animations"))));if(!Previous||!Previous->Character||!Low||!Walk||Walk->Animations.IsEmpty()||Previous->SourceHash!=Low->SourceHash)return 1;FAssetCompilingManager::Get().FinishAllCompilation();
   if(FPackageName::DoesPackageExist(NearRoot/TEXT("Face"))&&FPackageName::DoesPackageExist(LowRoot/TEXT("Character"))){auto* ExistingFace=LoadObject<UOKCrowdFaceDetail>(nullptr,*(NearRoot/TEXT("Face.Face")));auto* ExistingCard=LoadObject<UKKImportedCharacter>(nullptr,*(LowRoot/TEXT("Character.Character")));if(!ExistingFace||!ExistingCard||ExistingFace->SourceHash!=Low->SourceHash||ExistingCard->SourceHash!=Low->SourceHash)return 1;auto Row=MakeShared<FJsonObject>();Row->SetNumberField(TEXT("index"),Index);Row->SetBoolField(TEXT("already_prepared"),true);Rows.Add(MakeShared<FJsonValueObject>(Row));UE_LOG(LogTemp,Display,TEXT("Hair shell repair existing complete index=%d"),Index);CollectGarbage(RF_NoFlags);continue;}
   if(FPackageName::DoesPackageExist(NearRoot/TEXT("Face"))||FPackageName::DoesPackageExist(LowRoot/TEXT("Character")))return 1;
   auto* Near=FreshPackedAsset<UKKImportedCharacter>(NearRoot/TEXT("Character"));auto* Face=FreshPackedAsset<UOKCrowdFaceDetail>(NearRoot/TEXT("Face"));auto* Card=FreshPackedAsset<UKKImportedCharacter>(LowRoot/TEXT("Character"));auto* Library=FreshPackedAsset<UKKImportedAnimationLibrary>(LowRoot/TEXT("Walk/Animations"));if(!Near||!Face||!Card||!Library)return 1;
   Near->SourceHash=Previous->Character->SourceHash;Near->Schema=Previous->Character->Schema;Near->Outfits=Previous->Character->Outfits;Face->Character=Near;Face->SourceHash=Previous->SourceHash;Face->LowPartNames=Previous->LowPartNames;Face->LowPackedSlots=Previous->LowPackedSlots;Face->LowHairTriangles=Previous->LowHairTriangles;Face->NearHairTriangles=Previous->NearHairTriangles;
   Card->SourceHash=Low->SourceHash;Card->Schema=Low->Schema;Card->Outfits=Low->Outfits;Library->Character=Card;Library->Animations=Walk->Animations;
   TSet<UMaterialInterface*> Materials;for(const auto& Part:Near->Outfits[0].Parts)if(Part.Role==TEXT("hair"))for(const auto& M:Part.SkinnedModel->GetMaterials())Materials.Add(M.MaterialInterface.Get());
   int32 NearChanged=0,LowChanged=0,Serial=0;for(auto& Part:Near->Outfits[0].Parts)if(Part.Role==TEXT("hair")){int32 Changed=0;Part.SkinnedModel=OKRepairCrowdHairOutline(Part.SkinnedModel,Walk->Animations[0].Sequence,Materials,NearRoot/FString::Printf(TEXT("Hair%d"),Serial++),Changed);if(!Part.SkinnedModel)return 1;NearChanged+=Changed;}
   Serial=0;for(auto& Part:Card->Outfits[0].Parts)if(Part.SkinnedModel){int32 Changed=0;Part.SkinnedModel=OKRepairCrowdHairOutline(Part.SkinnedModel,Walk->Animations[0].Sequence,Materials,LowRoot/FString::Printf(TEXT("HairShellSkin%d"),Serial++),Changed);if(!Part.SkinnedModel)return 1;LowChanged+=Changed;}
   if(!SavePackedAsset(Near)||!SavePackedAsset(Face)||!SavePackedAsset(Library)||!SavePackedAsset(Card))return 1;auto Row=MakeShared<FJsonObject>();Row->SetNumberField(TEXT("index"),Index);Row->SetNumberField(TEXT("near_flipped"),NearChanged);Row->SetNumberField(TEXT("low_flipped"),LowChanged);Row->SetNumberField(TEXT("near_hair_triangles"),Face->NearHairTriangles);Rows.Add(MakeShared<FJsonValueObject>(Row));UE_LOG(LogTemp,Display,TEXT("Hair shell repair complete index=%d near=%d low=%d"),Index,NearChanged,LowChanged);
  }CollectGarbage(RF_NoFlags);
 }auto Root=MakeShared<FJsonObject>();Root->SetArrayField(TEXT("cards"),Rows);FString Text;FJsonSerializer::Serialize(Root,TJsonWriterFactory<>::Create(&Text));return FFileHelper::SaveStringToFile(Text,*Output)?0:1;
}
